# ═══════════════════════════════════════════════════════════════════════════════
# APACHE / LITESPEED CONFIGURATION — RexonSoftTech Employee Rights India
# ═══════════════════════════════════════════════════════════════════════════════

# 1. SPA URL Rewrites & Direct Static File Pass-Through
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect for trailing slashes on static files
  RewriteRule ^robots\.txt/$ /robots.txt [R=301,L]
  RewriteRule ^sitemap\.xml/$ /sitemap.xml [R=301,L]
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]

  # Pass-through existing static files & root files directly
  RewriteRule ^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt|humans\.txt|BingSiteAuth\.xml)$ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>

# 2. Strict Content Types
<Files "sitemap.xml">
  ForceType application/xml
  Header set Content-Type "application/xml; charset=utf-8"
</Files>

<Files "robots.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

<Files "llms.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

<Files "llms-full.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

<Files "humans.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

# 3. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# 4. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>
